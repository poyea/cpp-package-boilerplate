{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 3,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
                "CPP_PACKAGE_BOILERPLATE_BUILD_BENCHMARKS": "OFF",
                "CPP_PACKAGE_BOILERPLATE_BUILD_DOCS": "OFF"
            }
        },
        {
            "name": "debug-vcpkg",
            "inherits": [
                "debug"
            ],
            "binaryDir": "${sourceDir}/build/debug-vcpkg",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "release",
            "inherits": [
                "debug"
            ],
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release-vcpkg",
            "inherits": [
                "release"
            ],
            "binaryDir": "${sourceDir}/build/release-vcpkg",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "ci",
            "inherits": [
                "debug"
            ],
            "binaryDir": "${sourceDir}/build/ci",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CPP_PACKAGE_BOILERPLATE_ENABLE_SANITIZERS": "OFF"
            }
        },
        {
            "name": "ci-vcpkg",
            "inherits": [
                "ci"
            ],
            "binaryDir": "${sourceDir}/build/ci-vcpkg",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "benchmarks",
            "inherits": [
                "debug"
            ],
            "binaryDir": "${sourceDir}/build/benchmarks",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CPP_PACKAGE_BOILERPLATE_BUILD_TESTS": "OFF",
                "CPP_PACKAGE_BOILERPLATE_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "benchmarks-vcpkg",
            "inherits": [
                "benchmarks"
            ],
            "binaryDir": "${sourceDir}/build/benchmarks-vcpkg",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "profile",
            "inherits": [
                "benchmarks"
            ],
            "binaryDir": "${sourceDir}/build/profile",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "profile-vcpkg",
            "inherits": [
                "profile"
            ],
            "binaryDir": "${sourceDir}/build/profile-vcpkg",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "tidy",
            "inherits": [
                "debug"
            ],
            "binaryDir": "${sourceDir}/build/tidy",
            "cacheVariables": {
                "CPP_PACKAGE_BOILERPLATE_ENABLE_SANITIZERS": "OFF",
                "CPP_PACKAGE_BOILERPLATE_ENABLE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "tidy-vcpkg",
            "inherits": [
                "tidy"
            ],
            "binaryDir": "${sourceDir}/build/tidy-vcpkg",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "docs",
            "inherits": [
                "debug"
            ],
            "binaryDir": "${sourceDir}/build/docs",
            "cacheVariables": {
                "CPP_PACKAGE_BOILERPLATE_BUILD_TESTS": "OFF",
                "CPP_PACKAGE_BOILERPLATE_BUILD_DOCS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
