Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  modernize-*,
  performance-*,
  readability-*,
  portability-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -readability-magic-numbers,
  -readability-identifier-length
WarningsAsErrors: '*'
HeaderFilterRegex: '^(include|src|tests|benchmarks)/'
FormatStyle: file
